{
  "openapi": "3.0.0",
  "info": {
    "title": "ajedrez_svc",
    "version": "0.1.0"
  },
  "paths": {
    "/api/ajedrez/sessions": {
      "get": {
        "tags": [
          "Ajedrez"
        ],
        "summary": "List sessions",
        "operationId": "list",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AjedrezSession"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Ajedrez"
        ],
        "summary": "Create new chess Session",
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionPlayers"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AjedrezSession"
                }
              }
            }
          }
        }
      }
    },
    "/api/ajedrez/sessions/{_session_uid}": {
      "get": {
        "tags": [
          "Ajedrez"
        ],
        "operationId": "open",
        "parameters": [
          {
            "name": "_session_uid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "format": "uint8",
                    "minimum": 0.0
                  }
                }
              }
            }
          }
        },
        "servers": [
          {
            "url": "ws://{server}/{base_path}",
            "description": "WebSocket connection",
            "variables": {
              "server": {
                "default": "127.0.0.1:8000"
              },
              "base_path": {
                "default": ""
              }
            }
          }
        ]
      }
    },
    "/echo": {
      "get": {
        "tags": [
          "Ajedrez"
        ],
        "operationId": "echo_channel",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "format": "uint8",
                    "minimum": 0.0
                  }
                }
              }
            }
          }
        },
        "servers": [
          {
            "url": "ws://{server}/{base_path}",
            "description": "WebSocket connection",
            "variables": {
              "server": {
                "default": "127.0.0.1:8000"
              },
              "base_path": {
                "default": ""
              }
            }
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AjedrezSession": {
        "type": "object",
        "required": [
          "black_player",
          "fen_state",
          "id",
          "pgn_state",
          "state",
          "white_player"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "white_player": {
            "type": "integer",
            "format": "int32"
          },
          "black_player": {
            "type": "integer",
            "format": "int32"
          },
          "state": {
            "type": "string"
          },
          "fen_state": {
            "type": "string"
          },
          "pgn_state": {
            "type": "string"
          },
          "created": {
            "type": "string",
            "format": "partial-date-time",
            "nullable": true
          },
          "updated": {
            "type": "string",
            "format": "partial-date-time",
            "nullable": true
          }
        }
      },
      "SessionPlayers": {
        "type": "object",
        "required": [
          "black_player",
          "white_player"
        ],
        "properties": {
          "black_player": {
            "type": "integer",
            "format": "int32"
          },
          "white_player": {
            "type": "integer",
            "format": "int32"
          }
        }
      }
    }
  }
}